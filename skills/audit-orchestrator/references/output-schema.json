{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandAIReadinessAuditReport",
  "type": "object",
  "required": [
    "site",
    "audited_at",
    "summary",
    "findings",
    "proactive_recommendations"
  ],
  "additionalProperties": true,
  "properties": {
    "site": {
      "type": "string",
      "description": "Target website audited"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO 8601 timestamp of audit execution"
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium", "low"],
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "severity",
          "evidence",
          "mechanism",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "crawlability",
              "structured_data",
              "entity_trust",
              "brand_corroboration",
              "user_experience"
            ]
          },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "evidence": { "type": "string" },
          "mechanism": { "type": "string" },
          "suggested_action": {
            "type": "object",
            "required": [
              "summary",
              "priority",
              "implementation_detail",
              "expected_outcome"
            ],
            "properties": {
              "summary": { "type": "string" },
              "priority": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              },
              "implementation_detail": { "type": "string" },
              "expected_outcome": { "type": "string" }
            }
          }
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "impact", "rationale", "suggested_action"],
        "properties": {
          "title": { "type": "string" },
          "impact": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "rationale": { "type": "string" },
          "suggested_action": { "type": "string" }
        }
      }
    }
  }
}
